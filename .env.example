# BRIGADIR environment (iteration 1). Copy to .env for local runs.
# For `docker compose up`, these are set in docker-compose.yml — this file
# documents the same variables for running backend/worker directly.

# Postgres 16 — system of record.
DATABASE_URL=postgres://brigadir:brigadir@localhost:5432/brigadir

# Redis 7 — BullMQ queues only.
REDIS_URL=redis://localhost:6379

# Path to the agents.yaml config (validated at startup; default ./agents.yaml).
AGENTS_CONFIG_PATH=./agents.yaml

# Backend HTTP port.
PORT=3000
