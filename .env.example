# BRIGADIR environment. Copy to .env for local runs.
# For `docker compose up`, these are set in docker-compose.yml — this file
# documents the same variables for running backend/worker directly.

# Postgres 16 — system of record.
DATABASE_URL=postgres://brigadir:brigadir@localhost:5434/brigadir

# Redis 7 — BullMQ queues only.
REDIS_URL=redis://localhost:6380

# Path to the agents.yaml config. OPTIONAL since feature 005 (FR-019): the DB is
# authoritative; a present yaml is imported once (insert-if-absent), never
# overwrites an existing row, and an absent file boots cleanly on DB-only config.
# AGENTS_CONFIG_PATH=   # optional one-time import (see agents.example.yaml); DB is authoritative

# Backend HTTP port.
PORT=3000

# --- Worker concurrency tuning (incident 2026-07-19 Phase 5, all OPTIONAL) ---
# Unset ⇒ pre-Phase-5 behavior (type capacity = sum of enabled profiles'
# max_parallel_runs; per-profile gate only). Read lazily by the worker.
#
# Ceiling on a type's summed capacity (worker.concurrency). The per-type
# variant (uppercased type) wins over the generic one. Must be an integer ≥ 1.
# EXECUTOR_MAX_TYPE_CONCURRENCY=6
# EXECUTOR_MAX_TYPE_CONCURRENCY_CLAUDE_CLI=6
#
# Per-model concurrency cap (JSON map model → positive integer): the gate holds
# a run whose model already has this many `running` across ALL profiles sharing
# it, so one model can't occupy the whole type capacity. A model absent from the
# map has no per-model cap.
# EXECUTOR_MODEL_LIMITS={"claude-opus-4-8":2}

# --- Durable-финализация: guard / проба / реконсайлер (feature 026) ---
# Все опциональны; при отсутствии — прежнее поведение. Читаются лениво.
#
# Пути артефакта tool-сервера для deployment guard (по умолчанию —
# <cwd>/packages/mcp-server/dist/main.js и .../src). Overr. для деплоя/тестов.
# BRIGADIR_MCP_SERVER_ENTRY=/abs/path/packages/mcp-server/dist/main.js
# BRIGADIR_MCP_SERVER_SRC=/abs/path/packages/mcp-server/src
#
# TTL мемоизации guard'а на pickup (мс, дефолт 10000).
# BRIGADIR_ARTIFACT_GUARD_TTL_MS=10000
#
# Корень ephemeral mcp-config + outbox (дефолт <os.tmpdir()>/brigadir/mcp-config).
# Один источник правды для писателя (executor) и читателей (exit/периодический
# реконсайл). Overr. в основном для изоляции интеграционных сьютов.
# BRIGADIR_MCP_CONFIG_ROOT=/abs/scratch/mcp-config
#
# Каденс периодического outbox-реконсайлера (мс, дефолт 60000) и ретеншн
# неразрешимых файлов (мс, дефолт 7 дней).
# BRIGADIR_OUTBOX_RECONCILE_EVERY_MS=60000
# BRIGADIR_OUTBOX_RETENTION_MS=604800000
#
# Pre-flight channel probe: таймаут пробы (мс, дефолт 2000), базовый/макс. hold
# TTL для backoff (дефолт 30000 / 300000).
# BRIGADIR_CHANNEL_PROBE_TIMEOUT_MS=2000
# BRIGADIR_CHANNEL_PROBE_BASE_TTL_MS=30000
# BRIGADIR_CHANNEL_PROBE_MAX_TTL_MS=300000

# --- Secrets (boot-required; no silent defaults — Constitution V) ---

# JWT secret for per-run callback tokens (RunTokenGuard).
BRIGADIR_JWT_SECRET=change-me-in-prod

# AES-256-GCM key for Jira credentials at rest (feature 005, FR-020/FR-023).
# 32 bytes, base64 OR hex. BOOT FAILS for both backend and worker if unset or
# mis-sized — there is never a plaintext credential regime.
#   generate:  openssl rand -base64 32
BRIGADIR_CREDENTIALS_KEY=

# Shared dashboard bearer token (feature 005, FR-001/FR-003). Guards every
# `/api/workspaces*` and `/api/agents*` route; the web dashboard sends it as
# `Authorization: Bearer <token>` (entered at runtime, never baked into the SPA).
#   generate:  openssl rand -hex 32
BRIGADIR_DASHBOARD_TOKEN=

# --- admin-MCP `brigadir-admin` (feature 012) ---
# Consumed ONLY by the stdio MCP server plugged into Claude Code (packages/admin-mcp),
# via the repo-root .mcp.json. Not read by backend/worker. Export these into the shell
# that launches `claude` (e.g. `set -a; source .env; set +a`) so ${VAR} in .mcp.json resolves.
#   BRIGADIR_API_URL reuses PORT above; BRIGADIR_DASHBOARD_TOKEN reuses the bearer above.
BRIGADIR_JIRA_EMAIL=you@example.com
#   Atlassian → Account → Security → API tokens
BRIGADIR_JIRA_API_TOKEN=

