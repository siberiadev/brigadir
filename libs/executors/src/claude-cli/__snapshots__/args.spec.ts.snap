:{"type":"string"},"pr_url":{"type":"string"},"commits":{"type":"array","items":{"type":"string"}},"files_changed":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"repos":{"maxItems":20,"type":"array","items":{"type":"object","properties":{"repo":{"type":"string","minLength":1,"maxLength":200},"branch":{"type":"string","maxLength":300},"pr_url":{"type":"string","maxLength":1000},"commits":{"maxItems":100,"type":"array","items":{"type":"string","maxLength":500}},"files_changed":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["repo"],"additionalProperties":false}}},"additionalProperties":false}},"required":["schema_version","outcome","summary","checks"],"additionalProperties":false}",
