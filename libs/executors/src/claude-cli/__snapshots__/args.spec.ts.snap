exports[`buildArgs (T077) > matches a snapshot of the built argv for a representative config 1`] = `
[
  "-p",
  "--output-format",
  "stream-json",
  "--verbose",
  "--json-schema",
  "{"type":"object","properties":{"schema_version":{"type":"number","const":1},"outcome":{"type":"string","enum":["success","failure","needs_human","routed","team"]},"summary":{"type":"string","maxLength":2000},"checks":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","maxLength":200},"status":{"type":"string","enum":["pass","fail","skip","warn"]},"reason":{"type":"string","maxLength":1000}},"required":["name","status"],"additionalProperties":false},"maxItems":50},"human_task":{"type":"object","properties":{"kind":{"type":"string","enum":["question","blocker","review"]},"title":{"type":"string","maxLength":120,"description":"One-line summary, plain text (no markdown) — shown as the task headline."},"details":{"type":"string","maxLength":4000,"description":"The task body in GitHub-flavored Markdown — the human reads this in a rendered viewer. Use headings, bullet/numbered lists, \`inline code\`, fenced \`\`\`code blocks\`\`\`, **bold**, links, and blockquotes to make it scannable. Do NOT wrap the whole thing in a single code fence."}},"required":["kind","title"],"additionalProperties":false},"routing":{"type":"object","properties":{"target_agent":{"type":"string","maxLength":200,"description":"Name of the enabled worker agent to hand the ticket back to."},"task":{"type":"string","maxLength":4000,"description":"Self-contained rework task in GitHub-flavored Markdown, framed as a fix of existing work."}},"required":["target_agent","task"],"additionalProperties":false},"team":{"type":"object","properties":{"agents":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200,"description":"Unique agent name (never the orchestrator's)."},"description":{"type":"string","minLength":1,"maxLength":500,"description":"One roster line: what this agent does (shown to the orchestrator in handoffs)."},"instruction":{"type":"string","minLength":1,"maxLength":8000,"description":"Self-contained role prompt in GitHub-flavored Markdown."},"trigger_status":{"type":"string","minLength":1,"maxLength":100,"description":"Board workflow status that starts this agent."},"status_running":{"type":"string","minLength":1,"maxLength":100},"status_success":{"type":"string","minLength":1,"maxLength":100},"status_failure":{"type":"string","minLength":1,"maxLength":100},"executor":{"type":"string","minLength":1,"maxLength":200,"description":"Executor PROFILE NAME (one of the enabled profiles listed in the handoff)."}},"required":["name","description","instruction","trigger_status","status_success","status_failure","executor"],"additionalProperties":false},"minItems":1,"maxItems":20}},"required":["agents"],"additionalProperties":false},"artifacts":{"type":"object","properties":{"branch":{"type":"string"},"pr_url":{"type":"string"},"commits":{"type":"array","items":{"type":"string"}},"files_changed":{"type":"integer"}},"additionalProperties":false}},"required":["schema_version","outcome","summary","checks"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}",
  "--model",
