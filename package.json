{
  "name": "brigadir",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @brigadir/contracts build && pnpm --filter @brigadir/mcp-server build && nest build backend && nest build worker && pnpm --filter @brigadir/web build",
    "build:backend": "nest build backend",
    "build:worker": "nest build worker",
    "build:smoke": "nest build smoke",
    "build:mcp-server": "pnpm --filter @brigadir/mcp-server build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @brigadir/contracts typecheck && pnpm --filter @brigadir/mcp-server typecheck",
    "lint": "eslint \"{apps,libs,packages}/**/*.ts\"",
    "test": "pnpm --filter @brigadir/contracts test && pnpm --filter @brigadir/mcp-server test && vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start:backend": "node dist/apps/backend/main.api.js",
    "start:worker": "node dist/apps/worker/main.worker.js",
    "smoke:run": "nest build smoke && node dist/apps/smoke/main.smoke.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.43",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "msw": "2",
    "testcontainers": "^10.16.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@brigadir/contracts": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.0",
    "ioredis": "^5.11.1",
    "p-queue": "6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.1",
    "zod": "^4.0.0"
  }
}
