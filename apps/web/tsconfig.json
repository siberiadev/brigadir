{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@brigadir/contracts/agent-linter": ["../../packages/contracts/src/agent-linter.ts"],
      "@brigadir/contracts/pagination": ["../../packages/contracts/src/pagination.constants.ts"],
      "@brigadir/contracts/orchestrator-defaults": [
        "../../packages/contracts/src/orchestrator-defaults.ts"
      ],
      "@brigadir/contracts/executor-type-sets": [
        "../../packages/contracts/src/executor-type-sets.ts"
      ],
      "@brigadir/contracts/env": ["../../packages/contracts/src/env.constants.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "vite.config.ts", "vitest.config.ts", "env.d.ts"]
}
